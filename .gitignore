# ==============================================================================
# Production-ready .gitignore for Risk-Aware CI/CD Decision Support System
# Covers: Python/FastAPI, Node.js/Next.js, ML, Docker, and IDEs
# ==============================================================================

# --- Node.js / Next.js (Frontend) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/.turbo
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# --- Python (Backend) ---
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.pytest_cache/
backend/.mypy_cache/
backend/.tox/
backend/.coverage
backend/htmlcov/
backend/.env
backend/venv/
backend/env/
backend/ENV/
backend/build/
backend/dist/
backend/*.egg-info/

# --- ML / Model Artifacts ---
# Ignore serialized model files but keep the directory and READMEs
backend/app/ml/artifacts/*.pkl
backend/app/ml/artifacts/*.joblib
backend/app/ml/artifacts/*.h5
backend/app/ml/artifacts/*.onnx
!backend/app/ml/artifacts/README.md

# --- Databases ---
# Ignore local SQLite databases
backend/*.db
backend/*.sqlite3
backend/*.db-journal

# --- Environment & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
*.pem
*.key

# --- Docker ---
.docker/
# Only ignore data folders if they are generated by volumes
# data/

# --- IDE / Editor Configs ---
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject
.settings/

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs & Temp Files ---
*.log
backend/logs/
frontend/logs/
backend/scratch/
tmp/
temp/
