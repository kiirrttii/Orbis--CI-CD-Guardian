# =============================================================================
# Risk-Aware CI/CD Decision Support System — Backend
# Environment Configuration
# Copy this file to .env and populate with your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Risk-Aware CI/CD Decision Support System"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cicd_user
POSTGRES_PASSWORD=cicd_password
POSTGRES_DB=cicd_risk_db

# ── GitHub API ────────────────────────────────────────────────────────────────
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=30
GITHUB_MAX_RETRIES=3

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text    # json | text

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
